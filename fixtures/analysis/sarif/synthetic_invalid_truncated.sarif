{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.15.5",
          "rules": [
            {
              "id": "js/example-path-problem"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/example-path-problem",
          "ruleIndex": 0,
          "message": {
            "text": "Synthetic path-problem result."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "node_modules/lib-b/src/parse.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 42
                }
              }
         